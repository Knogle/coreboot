# UEFI and optional legacy boot in the same image; full EDK2, native ACS and lane options.
CONFIG_VENDOR_ASROCKRACK=y
CONFIG_BOARD_ASROCKRACK_B565D4_V1L=y
CONFIG_B565D4_LARGE_PAYLOAD=y
CONFIG_CONSOLE_SERIAL=y
CONFIG_TTYS0_BAUD=115200
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_5=y
CONFIG_COMPRESSED_PAYLOAD_LZMA=y
CONFIG_B565D4_NATIVE_GRAPHICS=y
CONFIG_MAINBOARD_DO_NATIVE_VGA_INIT=y
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y
# CONFIG_ON_DEVICE_ROM_LOAD is not set
# CONFIG_COMPRESS_PRERAM_STAGES is not set
# CONFIG_COLLECT_TIMESTAMPS is not set
# CONFIG_CONSOLE_CBMEM is not set
# CONFIG_USE_AMD_BLOBS is not set
CONFIG_B565D4_PCIE_RUNTIME_OPTIONS=y
CONFIG_USE_OPTION_TABLE=y
# CONFIG_STATIC_OPTION_TABLE is not set
# CONFIG_CMOS_POST is not set
# CONFIG_HAVE_ACPI_RESUME is not set
# CONFIG_VBOOT is not set
# CONFIG_TPM is not set
# CONFIG_COOP_MULTITASKING is not set
# CONFIG_DEBUG_HW_BREAKPOINTS is not set
# CONFIG_DEBUG_HW_BREAKPOINTS_IN_ALL_STAGES is not set
# CONFIG_DEBUG_NULL_DEREF_BREAKPOINTS is not set
# CONFIG_DEBUG_NULL_DEREF_BREAKPOINTS_IN_ALL_STAGES is not set
# CONFIG_DEBUG_STACK_OVERFLOW_BREAKPOINTS is not set
# CONFIG_DEBUG_STACK_OVERFLOW_BREAKPOINTS_IN_ALL_STAGES is not set
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_UEFIPAYLOAD=y
CONFIG_EDK2_REPO_MRCHROMEBOX=y
CONFIG_EDK2_RELEASE=y
CONFIG_EDK2_BOOT_TIMEOUT=5
CONFIG_EDK2_SERIAL_SUPPORT=y
CONFIG_EDK2_HAVE_EFI_SHELL=y
# CONFIG_EDK2_DISABLE_TPM is not set
CONFIG_EDK2_PS2_SUPPORT=y
CONFIG_EDK2_BOOTSPLASH_FILE="Documentation/coreboot_logo.bmp"
CONFIG_EDK2_USE_LVGL_RENDERER=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D SMM_SUPPORT=FALSE -D USE_CBMEM_FOR_CONSOLE=FALSE -D RAM_DISK_ENABLE=TRUE -D NETWORK_PXE_BOOT=TRUE -D NETWORK_IP6_ENABLE=TRUE -D NETWORK_HTTP_BOOT_ENABLE=TRUE -D NETWORK_TLS_ENABLE=TRUE -D NETWORK_ISCSI_ENABLE=TRUE -D NETWORK_VLAN_ENABLE=TRUE"
CONFIG_POWER_STATE_ON_AFTER_FAILURE=y
CONFIG_EDK2_ENABLE_IPXE=y
CONFIG_BUILD_IPXE=y
CONFIG_IPXE_STABLE=y
# CONFIG_IPXE_SERIAL_CONSOLE is not set
# CONFIG_IPXE_EFI_DEVICE_SPECIFIC is not set
CONFIG_B565D4_PCIE_FOUR_X4=y
CONFIG_B565D4_FADT_COLD_RESET=y
CONFIG_LOCALVERSION="alpha8-CSM-setup-test"
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_EDK2_LOAD_OPTION_ROMS=y

CONFIG_PCIEXP_ASPM=y

CONFIG_B565D4_PCIE_ACS=y

CONFIG_EDK2_CSMWRAP=y

CONFIG_B565D4_BOARD_SETUP=y

CONFIG_B565D4_EDK2_NVSTORE=y
