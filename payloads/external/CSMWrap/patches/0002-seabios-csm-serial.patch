                               csm_compat_table.ExtraPciRootListCount);
     }
+    if (CONFIG_CSM_SERCON_PORT)
+        const_romfile_add_int("etc/sercon-port", CONFIG_CSM_SERCON_PORT);
     pci_probe_devices();
 
     csm_compat_table.PnPInstallationCheckSegment = SEG_BIOS;
