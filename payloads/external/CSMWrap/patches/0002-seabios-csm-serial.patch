diff --git a/src/Kconfig b/src/Kconfig
index 676c70af..a3cf302f 100644
--- a/src/Kconfig
+++ b/src/Kconfig
@@ -308,6 +308,14 @@ menu "Hardware support"
         help
             Support USB mice.
 
+    config CSM_SERCON_PORT
+        depends on CSM
+        hex "CSM serial console port (zero disables)"
+        default 0
+        help
+            Publish the serial-console port to the CSM BIOS. This is
+            separate from firmware debug output.
+
     config SERIAL
         bool "Serial port"
         default y
