+/* The EDK2 publisher validated the option layout and its current checksum.
+ * Copy while boot services own the source; SeaBIOS revalidates it before I/O.
+ */
+void capture_coreboot_cmos(struct csmwrap_priv *priv)
+{
+    static const EFI_GUID guid = {
+        0xd8ca7aa9, 0x3c49, 0x4dd3,
+        { 0xbc, 0xb5, 0xf0, 0x4a, 0x8d, 0x27, 0xce, 0x9b }
+    };
+    priv->cmos_metadata_size = 0;
+    for (UINTN i = 0; i < gST->NumberOfTableEntries; i++) {
+        EFI_CONFIGURATION_TABLE *table = &gST->ConfigurationTable[i];
+        if (memcmp(&table->VendorGuid, &guid, sizeof(guid)) != 0)
+            continue;
+        const uint32_t *layout = table->VendorTable;
+        if (!layout || layout[0] != 0xc8 || layout[1] < 12 ||
+            layout[1] > 2048 || layout[2] < 12 || layout[2] > layout[1])
+            return;
+        const uint32_t *checksum = (const void *)((const uint8_t *)layout + layout[1]);
+        if (checksum[0] != 0xcc || checksum[1] != 24 || checksum[5] != 1)
+            return;
+        priv->cmos_metadata_size = layout[1] + 24;
+        memcpy(priv->cmos_metadata, layout, priv->cmos_metadata_size);
+        return;
+    }
+}
