diff --git a/src/sercon.c b/src/sercon.c
--- a/src/sercon.c
+++ b/src/sercon.c
@@ -530,6 +530,9 @@
             ScreenAndDebug = 0;
 
     vgabios = GET_IVT(0x10);
+    struct segoff_s serial = FUNC16(entry_sercon);
+    if (vgabios.seg == serial.seg && vgabios.offset == serial.offset)
+        return; // A repeated CSM PrepareToBoot must not hook itself.
     seabios = FUNC16(entry_10);
     if (vgabios.seg != seabios.seg ||
         vgabios.offset != seabios.offset) {
