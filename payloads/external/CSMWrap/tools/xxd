#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
# Minimal binary-to-C conversion used by the upstream CSMWrap build.
import sys,re
from pathlib import Path
assert len(sys.argv)==3 and sys.argv[1]=='-i'
p=Path(sys.argv[2]);b=p.read_bytes();n=re.sub('[^a-zA-Z0-9_]','_',p.name)
print('unsigned char '+n+'[] = {')
for i in range(0,len(b),12):print('  '+', '.join('0x%02x'%x for x in b[i:i+12])+(','if i+12<len(b)else''))
print('};\nunsigned int '+n+'_len = '+str(len(b))+';')
