+// HCRST clears this revision's descriptor even though its context-save
+// engine needs sixteen scratchpad buffers. Publish the requirement after
+// reset, before either SeaBIOS or the OS caches it. Only a volatile XDATA
+// capability byte changes; controller code and EEPROM remain untouched.
+static void
+xhci_asm1142_scratchpads(struct usb_xhci_s *xhci)
+{
+    struct pci_device *pci = xhci->usb.pci;
+    if (!pci || pci_config_readl(pci->bdf, PCI_VENDOR_ID) != 0x12421b21
+        || pci_config_readl(pci->bdf, PCI_CLASS_REVISION) != 0x0c033000
+        || pci_config_readl(pci->bdf, PCI_SUBSYSTEM_VENDOR_ID) != 0x12421b21
+        || readl(&xhci->caps->hcsparams2) != 0x000000fa)
+        return;
+
+    u16 selector = pci_config_readw(pci->bdf, 0xe8);
+    pci_config_writew(pci->bdf, 0xe8, 0xf60b);
+    udelay(100);
+    if (pci_config_readw(pci->bdf, 0xe8) == 0xf60b) {
+        pci_config_writeb(pci->bdf, 0xea, 0x84);
+        udelay(1000);
+    }
+    pci_config_writew(pci->bdf, 0xe8, selector);
+    dprintf(3, "XHCI ASM1142 scratchpad capability %08x, selector restored=%d\n"
+            , readl(&xhci->caps->hcsparams2)
+            , pci_config_readw(pci->bdf, 0xe8) == selector);
+}
+
 static void
 configure_xhci(void *data)
 {
@@ -471,6 +499,8 @@
         goto fail;
     if (wait_bit(&xhci->op->usbsts, XHCI_STS_CNR, 0, 1000) != 0)
         goto fail;
+
+    xhci_asm1142_scratchpads(xhci);
 
     writel(&xhci->op->config, xhci->slots);
     writel(&xhci->op->dcbaap_low, (u32)xhci->devs);
