# Westmere-EP/Gulftown CPU support. Board policy selects the optional
# board-specific init capabilities below; reusable CPU code must not depend on a
# particular mainboard symbol.
config CPU_INTEL_MODEL_206CX
	bool
	select ARCH_X86
	select HAVE_X86_64_SUPPORT
	select SSE2
	select SUPPORT_CPU_UCODE_IN_CBFS

config CPU_INTEL_MODEL_206CX_INIT
	bool
	depends on CPU_INTEL_MODEL_206CX
	select X86_MP_INIT_INHERIT_PAT
	select X86_MP_INIT_REQUIRE_ALL_CPUS

config CPU_INTEL_MODEL_206CX_SMP
	bool
	depends on CPU_INTEL_MODEL_206CX_INIT
	select X86_INIT_NEED_2ND_SIPI
