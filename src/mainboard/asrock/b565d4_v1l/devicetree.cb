# Deliberately incomplete: only the bootblock is supported.
chip soc/amd/cezanne
	device domain 0 on
		device ref lpc_bridge on
			chip superio/nuvoton/nct6796d
				device pnp 2e.2 off end
				device pnp 2e.3 off end
			end
			chip superio/aspeed/ast2400
				device pnp 4e.3 on
					io 0x60 = 0x2f8
					irq 0x70 = 3
				end
			end
		end
	end
end
