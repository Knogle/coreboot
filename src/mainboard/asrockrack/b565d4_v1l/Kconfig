	string "Cezanne microcode patch"
	default "3rdparty/blobs/mainboard/asrockrack/b565d4_v1l/cpu_microcode_a500.bin"

config B565D4_DESKTOP_CPU_PREPARATION
	bool "Include Matisse/Vermeer microcode for CPU port preparation"
	help
	  Include five matching processor-revision patches alongside the existing
	  Cezanne patch. The default files come from the qualified board firmware.
	  An explicitly selected directory may supply newer matching patches;
	  processor bindings and revision floors are checked during packing.
	  The build audits the retained Matisse/Vermeer PSP, ABL and APCB data.
	  This option alone only prepares firmware inputs. Select Matisse or
	  Vermeer to use a desktop runtime. Physical CPU-swap qualification
	  remains necessary. Without a desktop runtime, the Cezanne backend
	  and its CPU match remain unchanged.

config B565D4_DESKTOP_MICROCODE_DIR
	string "Desktop microcode directory"
	depends on B565D4_DESKTOP_CPU_PREPARATION
	default "3rdparty/blobs/mainboard/asrockrack/b565d4_v1l/desktop-microcode"

config B565D4_VERMEER_BOOT_MICROCODE
	bool
	depends on B565D4_VERMEER && B565D4_DESKTOP_CPU_PREPARATION
	help
	  Select the same qualified original A21213 input for CBFS and the two
	  existing BIOS type 0x66 slots. Packing checks the exact processor,
	  size and original file hash. Selected by the matching ABL cohort;
	  the old ABL with these boot slots failed physical qualification.

config B565D4_VERMEER_ABL_F20
	bool "Use the original Vermeer B2 F20 ABL cohort (experimental)"
	depends on B565D4_VERMEER && B565D4_DESKTOP_CPU_PREPARATION
	depends on PAYLOAD_EDK2 || PAYLOAD_SEABIOS
	select B565D4_VERMEER_BOOT_MICROCODE
	select B565D4_LARGE_PAYLOAD
	help
	  Install the complete original signed Vermeer ABL from the qualified
	  F20 firmware. The packer checks the exact whole-unit hash, all twenty
	  stages and four directory updates. Other PSP code, keys, APCB and fuse
	  policy remain unchanged. The larger payload layout leaves space for
	  this unit and is required for both EDK2 and SeaBIOS.
	  Normal Vermeer B2 SeaBIOS and EDK2 builds have bounded physical
	  boot and KVM evidence. Other CPUs and production qualification
	  remain separate. The packer rejects either half of this cohort alone.

config B565D4_VERMEER_ABL_FILE
	string "Original Vermeer F20 ABL binary"
	depends on B565D4_VERMEER_ABL_F20
	default "3rdparty/blobs/mainboard/asrockrack/b565d4_v1l/vermeer-f20-abl.bin"

config B565D4_VERMEER_MICROCODE_ADDRESS
	bool "Use the original Vermeer microcode pointer handoff (experimental)"
	depends on B565D4_VERMEER_BOOT_MICROCODE
	help
	  Reproduce the literal patch-buffer pointer handoff observed in both
	  original ASRock and comparison Zen3 DXE loaders before the ordinary
	  PATCH_LOADER write. Limited to the studied Vermeer B2 / A21213 path;
	  other CPUs keep the existing path. Requires physical qualification.
	  No microcode signature, revision or firmware authentication is changed.

config B565D4_LARGE_PAYLOAD
	bool "Use the larger payload storage region (experimental)"
	depends on PAYLOAD_EDK2 || PAYLOAD_SEABIOS
	help
	  Store a payload of up to approximately 3 MiB in place of three unused
	  vendor FV_IMAGE files. The native coreboot flow does not execute these
	  files. PSP and BIOS directory sources remain outside this region.
	  This changes only payload storage, not its load address in DRAM.

choice
	prompt "CPU x16 slot lane configuration"
	default B565D4_PCIE_X16

config B565D4_PCIE_X16
	bool "x16"

config B565D4_PCIE_X8X4X4
	bool "x8/x4/x4"
	depends on !B565D4_DESKTOP_NATIVE
	help
	  Split the CPU slot across the Cezanne GFX and GPP hardware blocks.
	  Physical lanes 9-12 use logical DXIO lanes 12-15.

config B565D4_PCIE_FOUR_X4
	bool "x4/x4/x4/x4"
	help
	  The experimental Vermeer backend builds its separate desktop six-port
	  policy. Its physical link allocation still needs qualification.

	  Use the six-engine SMU allocation observed on this board: four
	  slot engines plus the existing separate GPP and chipset links. The slot
	  engines span two GFX and two GPP hardware ports.

config B565D4_PCIE_FOUR_X4_PROBE
	bool "Four x4 engines: SMU allocation probe, stops before mapping"
	depends on !B565D4_DESKTOP_NATIVE
	help
	  Experimental diagnostic for the requested x4/x4/x4/x4 topology.
	  The documented Cezanne GFX bridge exposes only three root ports.
	  Report the SMU engine-allocation result, then stop before programming
	  an unqualified fourth host port. This option does not boot a payload.

endchoice

config B565D4_PCIE_RUNTIME_OPTIONS
	bool "Allow changing CPU-slot PCIe lanes in CMOS"
	depends on !B565D4_PCIE_FOUR_X4_PROBE
	select HAVE_OPTION_TABLE
	select HAVE_CMOS_DEFAULT
	select MAINBOARD_NEEDS_CMOS_OPTIONS
	select DRIVERS_OPTION_CFR_ENABLED
	help
	  Read the CPU-slot lane configuration through the standard coreboot
	  option API. Use CMOS as the option backend. The lane choice above
	  remains the default when no valid override is stored.

	  SeaBIOS can expose the CMOS options through the nvramcui secondary
	  payload. CFR describes the same option for a compatible setup menu.
	  A changed setting requires a full power cycle.
	  The desktop backends support x16 and x4/x4/x4/x4 only.

config B565D4_NATIVE_GRAPHICS
	bool "Initialize the ASPEED framebuffer"
	select DRIVERS_ASPEED_AST2050
	help
	  Initialize AST2500 graphics with the existing ASPEED native driver.
	  A linear framebuffer can be shared with SeaBIOS and EDK2. Serial
	  remains available independently of graphics.

config B565D4_PCIE_ACS
	bool "Initialize Cezanne PCIe Access Control Services (experimental)"
	depends on !B565D4_DESKTOP_NATIVE
	help
	  Apply the Cezanne NBIF ACS straps and request the seven ACS features
	  through the normal DXIO wrapper descriptors before link training.
	  Linux must discover and enable the resulting hardware capabilities.
	  This does not override IOMMU groups or guarantee chipset isolation.

config B565D4_FADT_COLD_RESET
	bool "Prepare and advertise the CF9 cold reset (experimental)"
	help
	  Enable CF9 decoding and the complete power-good reset policy before
	  describing the reset register in ACPI. This option requires physical
	  reboot qualification with the selected payload. It does not add S3
	  resume support or trigger a reset during board initialization.

config B565D4_SKIP_SAS_OPROM
	bool "Suppress the SAS2308 legacy boot ROM"
	depends on PAYLOAD_BUILD_SEABIOS
	help
	  Provide SeaBIOS with an empty ROM override for PCI 1000:0087.
	  Linux can initialize the adapter with mpt2sas independently of its
	  legacy boot ROM. This setting leaves the adapter and its BARs enabled.

endif
