config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select SOC_AMD_CEZANNE if !B565D4_DESKTOP_NATIVE
	select SOC_AMD_CEZANNE_BASE if B565D4_DESKTOP_NATIVE
	select SOC_AMD_CEZANNE_FSP_USB_LAYOUT if B565D4_DESKTOP_NATIVE
	select SOC_AMD_CEZANNE_NATIVE
	select SOC_AMD_CEZANNE_NATIVE_CPU_IDENTITY_PROVIDER if B565D4_DESKTOP_NATIVE
	select PCI_SCAN_PRE_BRIDGE_HOOK if PCI
	select PCI_SCAN_VENDOR_ID_HOOK if PCI
	select SOC_AMD_COMMON_BLOCK_CPU_SYNC_PSP_ADDR_MSR
	select SOC_AMD_COMMON_BLOCK_UCODE_BOOTBLOCK if B565D4_MATISSE
	select SOC_AMD_COMMON_BLOCK_CLEAR_HLE_RTM
	select SOC_AMD_COMMON_BLOCK_APOB_NV_DISABLE
	select SOC_AMD_COMMON_BLOCK_SPI_PRESERVE_BOOTBLOCK_MODE
	select BOARD_ROMSIZE_KB_32768
	select SUPERIO_NUVOTON_NCT6796D
	select SUPERIO_ASPEED_AST2400
	select SUPERIO_ASPEED_HAS_UART_DELAY_WORKAROUND
	select BOOTBLOCK_CONSOLE
	select NO_STAGE_CACHE
	select NO_XIP_EARLY_STAGES
	select NO_SMM
	select NO_FMAP_CACHE
	select NO_CBFS_MCACHE
	select CBMEM_BOUNDED_ARENA
	select CBMEM_BOUNDED_EXTERNAL_HANDLE
	select CBMEM_BOUNDED_SKIP_RAM_CHECK
	select GENERATE_SMBIOS_TABLES
	select POWER_STATE_DEFAULT_ON_AFTER_FAILURE

config MAINBOARD_DIR
	default "asrockrack/b565d4_v1l"

config B565D4_VERMEER
	bool "Experimental Vermeer native bring-up"
	depends on !B565D4_MATISSE
	select B565D4_DESKTOP_NATIVE
	help
	  Build the separate desktop CPU path for Ryzen 5000 Vermeer. The
	  retained board PSP/ABL/APCB cohort still owns DRAM training. This
	  selects desktop register interfaces before the first model-specific
	  access. Physical CPU-swap qualification is required. Keep the
	  qualified Cezanne image available as the return image.

config B565D4_MATISSE
	bool "Experimental Matisse native bring-up"
	select B565D4_DESKTOP_NATIVE
	help
	  Build the separate Ryzen 3000 Matisse desktop path. The initial
	  target is a single-CCD 3700X with two four-core complexes. Preserve
	  the matching board PSP/ABL/APCB cohort and qualify the actual
	  memory, AP, device and payload handoff after a physical CPU swap.

config B565D4_DESKTOP_NATIVE
	bool
	select B565D4_DESKTOP_CPU_PREPARATION
	select SOC_AMD_COMMON_BLOCK_ROOT_COMPLEX

config B565D4_DESKTOP_INTX
	bool "Describe desktop GNB child INTx routes"
	depends on B565D4_VERMEER
	default y
	help
	  Generate IOAPIC-only child _PRT tables from the logical GNB interrupt
	  registers. Physical NBIF port remapping does not renumber these routes.
	  This replaces the retained APU child
	  tables and does not reprogram interrupt routing or describe root-port
	  own interrupts. Physical INTx delivery needs separate qualification.

config B565D4_DESKTOP_PCIE_MAX_SPEED
	int "CPU PCIe slot maximum generation (0: unchanged)"
	depends on B565D4_DESKTOP_NATIVE
	range 0 4
	default 3 if B565D4_VERMEER
	default 0
	help
	  Request a CPU-port generation during DXIO initialization and through
	  its bound-engine speed service before ordinary PCI scanning. The
	  chipset uplink is handled separately. Zero keeps the existing policy.
	  The standard PCIe pre-scan path checks the resulting link state.
	  Vermeer defaults to the qualified Gen3 initialization. Higher rates
	  require independent board and endpoint qualification.

config B565D4_DESKTOP_PCH_MAX_SPEED
	int "Chipset uplink maximum generation (0: unchanged)"
	depends on B565D4_DESKTOP_NATIVE
	range 0 3
	default 3 if B565D4_VERMEER
	default 0
	help
	  Request the chipset uplink speed through the bound DXIO engine after
	  Promontory firmware upload and before permanent resource assignment.
	  Zero keeps the existing initialization sequence. Vermeer refreshes the
	  bound port speed policy after chipset firmware and defaults to Gen3.
	  Lower limits remain available for board and endpoint qualification.

config B565D4_VERMEER_SMU_TELEMETRY
	bool "Reserve the original Vermeer SMU telemetry buffer"
	depends on B565D4_VERMEER
	help
	  Register a persistent 16-KiB CBMEM owner for SMU384c telemetry,
	  following the original board's reserved-memory allocation contract.
	  This does not request a table export or change CPU power policy.
	  Experimental; target buffer and OS telemetry access need qualification.

config B565D4_VERMEER_CORE_C6
	bool "Vermeer core C6 idle support"
	depends on B565D4_VERMEER
	help
	  Prepare the original Zen3 per-core C6 controls and desktop C-state
	  I/O address during normal CPU initialization. After all CPUs and the
	  matching SMU384c PowerPlay service are ready, request core C6 once.
	  Publish the matching ACPI C2 entry only after that preparation succeeds.
	  Package C6, fabric C-states and S3 are separate paths. This opt-in
	  setting requires physical idle, KVM and selected-payload qualification.
	  Desktop board setup can disable the policy for the next cold boot.

config B565D4_DESKTOP_PCIE_ACS
	bool "Request desktop PCIe Access Control Services (experimental)"
	depends on B565D4_VERMEER
	help
	  Request the seven wrapper ACS features using the native desktop DXIO
	  reconfiguration path before training. Linux must discover and enable
	  the resulting hardware capabilities. This does not override IOMMU
	  groups or guarantee chipset isolation.

config B565D4_MATISSE_IRQ_DIAGNOSTIC
	bool "Stop after native Matisse interrupt diagnostics"
	depends on B565D4_MATISSE
	help
	  Measure owned BSP interrupts before and after MP initialization.
	  Compare CPUID-qualified original-board MSR masks on the BSP, with separate
	  interrupt measurements. This is a private register-group experiment.
	  This private diagnostic deliberately stops before loading a payload;
	  pending diagnostic vectors must not cross the payload handoff.
	  Leave disabled for normal firmware builds.

config B565D4_MATISSE_PCI_ACCESS_DIAGNOSTIC
	bool "Log Matisse PCI configuration access before payload entry"
	depends on B565D4_MATISSE
	help
	  Compare byte, word and DWORD reads through ECAM and CF8/CFC on the
	  discovered chipset path. Preserve the incoming CF8 selector and log
	  the existing NBIO machine-check status without clearing it. This
	  diagnostic does not repair configuration or stop before the payload.
	  Leave disabled for normal firmware builds.

config B565D4_MATISSE_PRE_SOC_IRQ_DIAGNOSTIC
	bool "Stop after Matisse interrupt diagnostic before SoC initialization"
	depends on B565D4_MATISSE
	help
	  After the raw UART setup, test a separate software interrupt and an
	  owned BSP fixed IPI before entering the ordinary SoC C initialization.
	  This private diagnostic stops in bootblock and does not load a payload.
	  Leave disabled for normal firmware builds.

config B565D4_MATISSE_SKIP_EARLY_MICROCODE
	bool "Defer microcode to MP initialization for the private IRQ comparison"
	depends on B565D4_MATISSE_IRQ_DIAGNOSTIC
	help
	  Compare the original-board BSP register group before applying a patch,
	  as observed in the original PEI path. Ordinary MP initialization still
	  applies the selected microcode. The private diagnostic stops before
	  loading a payload. Leave disabled for normal firmware builds.

config B565D4_MATISSE_ALL_CPU_MSR_TRIAL
	bool "Compare original Matisse MSR selectors during per-CPU initialization"
	depends on B565D4_MATISSE_SKIP_EARLY_MICROCODE
	help
	  Apply the private register group with the original thread/core/CCX
	  selector predicates in each ordinary CPU initialization callback.
	  This is limited to the installed 16-thread 870F10 test configuration;
	  it does not generalize the platform-dependent table predicates.
	  The existing IRQ diagnostic still stops before loading a payload.
	  Leave disabled for normal firmware builds.

config B565D4_MATISSE_SINGLE_MSR_IRQ_TRIAL
	bool "Measure one Matisse IRQ after the private per-CPU MSR comparison"
	depends on B565D4_MATISSE_ALL_CPU_MSR_TRIAL
	help
	  Apply the same private register group and complete ordinary MP
	  initialization before requesting the first diagnostic fixed interrupt.
	  This separates the register comparison from an earlier pending request.
	  Stop after that single measurement, before loading a payload.
	  Leave disabled for normal firmware builds.

config B565D4_MATISSE_PRE_SOC_MICROCODE
	bool "Apply matching microcode before the private pre-SoC IRQ test"
	depends on B565D4_MATISSE_PRE_SOC_IRQ_DIAGNOSTIC
	help
	  Compare a separate cold boot with microcode loaded before the first
	  diagnostic APIC enable and before ordinary SoC C initialization.
	  This option is only for the private diagnostic, which stops in bootblock.

config B565D4_MATISSE_PRE_SOC_STGI
	bool "Execute STGI before the private pre-SoC IRQ test"
	depends on B565D4_MATISSE_PRE_SOC_MICROCODE
	help
	  Compare a separate cold boot with SVM enabled only for STGI, before
	  the first diagnostic APIC enable. Restore EFER without entering a VM.
	  This private diagnostic stops before ordinary SoC C initialization.

config B565D4_MATISSE_PRE_SOC_CACHE
	bool "Set up ordinary caching before the private pre-SoC IRQ test"
	depends on B565D4_MATISSE_PRE_SOC_STGI
	help
	  Call the existing DRAM-first early_cache_setup before the private IRQ
	  comparison. Do not run the remaining SoC initialization or a payload.
	  This diagnostic leaves the ordinary memory types and caches enabled.

config DEVICETREE
	default "vermeer/devicetree.cb" if B565D4_DESKTOP_NATIVE

config CHIPSET_DEVICETREE
	default "mainboard/asrockrack/b565d4_v1l/vermeer/chipset.cb" if B565D4_DESKTOP_NATIVE

config B565D4_BOARD_SETUP
	bool "Extended board setup (experimental)"
	depends on B565D4_PCIE_RUNTIME_OPTIONS && !B565D4_DESKTOP_NATIVE
	help
	  Share checked CMOS board settings between nvramcui and EDK2 CFR.
	  This profile uses a versioned CMOS layout and requires qualification
	  of each hardware policy. Existing release profiles remain unchanged.

config B565D4_DESKTOP_SETUP
	bool "Desktop board setup development backend"
	depends on B565D4_VERMEER && B565D4_PCIE_RUNTIME_OPTIONS
	help
	  Develop native desktop consumers of the shared checked CMOS settings.
	  This backend is incomplete and is not a release profile. It does not
	  enable the Cezanne DF or CPU power implementations.

config SEABIOS_PATCHES_DIR
	default "src/mainboard/asrockrack/b565d4_v1l/seabios" if B565D4_DESKTOP_SETUP && PAYLOAD_SEABIOS

config CMOS_LAYOUT_FILE
	default "src/mainboard/asrockrack/b565d4_v1l/cmos_desktop_setup.layout" if B565D4_DESKTOP_SETUP
	default "src/mainboard/asrockrack/b565d4_v1l/cmos_setup.layout" if B565D4_BOARD_SETUP
	default "src/mainboard/asrockrack/b565d4_v1l/cmos_desktop.layout" if B565D4_DESKTOP_NATIVE

config B565D4_CPU_TCTL_LIMIT
	int "CPU Tctl ceiling in degrees C (experimental)"
	depends on B565D4_BOARD_SETUP || B565D4_VERMEER
	range 60 90
	default 85
	help
	  Request a conservative thermal ceiling on the qualified Cezanne or
	  Vermeer SMU. The Ryzen 5500 and 5600X use separate, version-checked
	  commands. Other CPU or SMU versions retain their own initialization.
	  This does not replace the platform's complete power or fan policy.

config B565D4_EDK2_NVSTORE
	bool "Persistent EFI variables in upper NVAR (experimental)"
	depends on B565D4_BOARD_SETUP || B565D4_DESKTOP_NATIVE
	depends on PAYLOAD_EDK2 && EDK2_REPO_MRCHROMEBOX
	help
	  Use the board's AMD FCH runtime FVB provider and ordinary EDK2 FTW
	  and variable services. Only the allocated 128-KiB upper NVAR volume
	  is writable. This retains NO_SMM and has no whole-flash update API.
	  External firmware updates must preserve this allocated store explicitly.

config B565D4_EDK2_CAPSULE_FCH
	bool "Experimental SMI-free EDK2 capsule handoff from upper NVAR"
	depends on B565D4_EDK2_NVSTORE && NO_SMM && BOOT_DEVICE_SUPPORTS_WRITES
	help
	  Let the generic EFI capsule scanner read CapsuleUpdateData and
	  OsIndications from this board's allocated upper NVAR region instead
	  of SMMSTORE. This only supplies capsule discovery and handoff.
	  It does not enable a flash writer; a separately qualified EDK2 FMP
	  backend is mandatory before selecting a physical update profile.

config B565D4_EDK2_CAPSULE_WRITE
	bool "Experimental board-specific EDK2 capsule flash backend"
	depends on B565D4_EDK2_CAPSULE_FCH
	help
	  Build the isolated full-image FMP policy and checked FCH sector backend.
	  This remains an experimental, unreleased profile until live ESRT, FMP,
	  capsule authentication, power-loss recovery and physical write gates pass.
	  Generic RMAP, BIOS-region and whole-flash fallback are bypassed.

config CMOS_DEFAULT_FILE
