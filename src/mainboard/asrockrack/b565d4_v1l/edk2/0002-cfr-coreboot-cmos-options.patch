diff --git a/UefiPayloadPkg/Include/Guid/CmosOptionTableHob.h b/UefiPayloadPkg/Include/Guid/CmosOptionTableHob.h
new file mode 100644
--- /dev/null
+++ b/UefiPayloadPkg/Include/Guid/CmosOptionTableHob.h
@@ -0,0 +1,65 @@
+/** @file
+  coreboot CMOS option layout and checksum information copied into a HOB.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef CMOS_OPTION_TABLE_HOB_H_
+#define CMOS_OPTION_TABLE_HOB_H_
+
+#include <Uefi.h>
+
+extern EFI_GUID  gEfiCmosOptionTableHobGuid;
+
+#define CB_CMOS_OPTION_TABLE  0x00c8
+#define CB_CMOS_OPTION        0x00c9
+#define CB_CMOS_ENUM          0x00ca
+#define CB_CMOS_CHECKSUM      0x00cc
+#define CB_CMOS_CHECKSUM_SUM  1
+#define CB_CMOS_NAME_LENGTH   32
+
+#pragma pack(1)
+
+typedef struct {
+  UINT32    Tag;
+  UINT32    Size;
+  UINT32    HeaderLength;
+} CB_CMOS_LAYOUT;
+
+typedef struct {
+  UINT32    Tag;
+  UINT32    Size;
+} CB_CMOS_RECORD;
+
+typedef struct {
+  UINT32    Tag;
+  UINT32    Size;
+  UINT32    Bit;
+  UINT32    Length;
+  UINT32    Config;
+  UINT32    ConfigId;
+  CHAR8     Name[1];
+} CB_CMOS_ENTRY;
+
+typedef struct {
+  UINT32    Tag;
+  UINT32    Size;
+  UINT32    ConfigId;
+  UINT32    Value;
+  CHAR8     Text[1];
+} CB_CMOS_ENUM_ENTRY;
+
+typedef struct {
+  UINT32    Tag;
+  UINT32    Size;
+  UINT32    RangeStart;
+  UINT32    RangeEnd;
+  UINT32    Location;
+  UINT32    Type;
+} CB_CMOS_CHECKSUM_ENTRY;
+
+#pragma pack()
+
+// The HOB contains the complete CB_CMOS_LAYOUT followed by its checksum record.
+
+#endif
diff --git a/UefiPayloadPkg/Library/CbParseLib/CbParseLib.c b/UefiPayloadPkg/Library/CbParseLib/CbParseLib.c
--- a/UefiPayloadPkg/Library/CbParseLib/CbParseLib.c
+++ b/UefiPayloadPkg/Library/CbParseLib/CbParseLib.c
@@ -21,6 +21,7 @@
 #include <IndustryStandard/Acpi.h>
 #include <Coreboot.h>
 #include <Guid/CfrSetupMenuGuid.h>
+#include <Guid/CmosOptionTableHob.h>
 #include <Guid/SdhciNonPciInfoGuid.h>
 #include <UniversalPayload/PciRootBridges.h>
 
@@ -752,6 +753,36 @@
   @retval RETURN_OUT_OF_RESOURCES      Insufficant memory space.
 
 **/
+STATIC
+VOID
+ParseCmosOptionInfo (
+  VOID
+  )
+{
+  CONST CB_CMOS_LAYOUT            *Layout;
+  CONST CB_CMOS_CHECKSUM_ENTRY    *Checksum;
+  UINT8                          *Data;
+
+  Layout = FindCbTag (CB_CMOS_OPTION_TABLE);
+  Checksum = FindCbTag (CB_CMOS_CHECKSUM);
+  if ((Layout == NULL) || (Checksum == NULL)) {
+    return;
+  }
+  if ((Layout->Size < sizeof (*Layout)) || (Layout->Size > 0xf000) ||
+      (Layout->HeaderLength < sizeof (*Layout)) ||
+      (Layout->HeaderLength > Layout->Size) ||
+      (Checksum->Size != sizeof (*Checksum)) ||
+      (Checksum->Type != CB_CMOS_CHECKSUM_SUM)) {
+    DEBUG ((DEBUG_WARN, "CFR: Invalid coreboot CMOS option metadata\n"));
+    return;
+  }
+  Data = BuildGuidHob (&gEfiCmosOptionTableHobGuid, Layout->Size + sizeof (*Checksum));
+  if (Data != NULL) {
+    CopyMem (Data, Layout, Layout->Size);
+    CopyMem (Data + Layout->Size, Checksum, sizeof (*Checksum));
+  }
+}
