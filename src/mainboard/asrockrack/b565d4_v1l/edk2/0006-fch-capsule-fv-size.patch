From: coreboot board integration
Subject: [PATCH] UefiPayloadPkg: allow space for board FMP in capsule builds

The FCH_SPI board capsule configuration adds FmpDxe and ESRT to a Release
payload. Give that opt-in configuration an 11-MiB FV. The ordinary Release
payload remains at its existing 10-MiB size.

--- a/UefiPayloadPkg/UefiPayloadPkg.fdf
+++ b/UefiPayloadPkg/UefiPayloadPkg.fdf
@@ -20,8 +20,13 @@
 !if $(TARGET) == DEBUG
 DEFINE FD_SIZE     = 0x0B00000
 DEFINE NUM_BLOCKS  = 0xB00
 !else
+!if $(CAPSULE_SUPPORT) == TRUE && $(VARIABLE_SUPPORT) == "FCH_SPI"
+DEFINE FD_SIZE     = 0x0B00000
+DEFINE NUM_BLOCKS  = 0xB00
+!else
 DEFINE FD_SIZE     = 0x0A00000
 DEFINE NUM_BLOCKS  = 0xA00
+!endif
 !endif
 !endif
