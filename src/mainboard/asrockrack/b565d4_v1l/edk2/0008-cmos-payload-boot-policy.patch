diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/BootPolicy.c b/UefiPayloadPkg/Library/PlatformBootManagerLib/BootPolicy.c
new file mode 100644
--- /dev/null
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/BootPolicy.c
@@ -0,0 +1,205 @@
+/** @file
+  Apply coreboot CMOS preferences without replacing OS-owned boot settings.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "PlatformBootManager.h"
+#include <Guid/GlobalVariable.h>
+#include <Library/CorebootCmosOptionLib.h>
+
+STATIC EFI_GUID  mPolicyGuid = {
+  0x29b2bc3d, 0x3af9, 0x4a9c, { 0xb4, 0x1f, 0x23, 0x51, 0xa5, 0x9a, 0x71, 0x88 }
+};
+
+UINT32
+PlatformCmosPreference (
+  IN CONST CHAR16  *Name,
+  IN UINT32        Default,
+  IN UINT32        Maximum
+  )
+{
+  UINT32  Value;
+
+  if (EFI_ERROR (CorebootCmosReadOption (Name, &Value)) || (Value > Maximum)) {
+    return Default;
+  }
+
+  return Value;
+}
+
+STATIC
+EFI_STATUS
+SavePreference (
+  IN CHAR16  *Name,
+  IN UINT8   Value
+  )
+{
+  return gRT->SetVariable (
+                Name,
+                &mPolicyGuid,
+                EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+                EFI_VARIABLE_RUNTIME_ACCESS,
+                sizeof (Value),
+                &Value
+                );
+}
+
+VOID
+PlatformSyncBootTimeout (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT32      Cmos;
+  UINT16      Timeout;
+  UINT8       Previous;
+  UINTN       Size;
+  BOOLEAN     HavePrevious;
+  BOOLEAN     HaveTimeout;
+
+  Status = CorebootCmosReadOption (L"boot_timeout", &Cmos);
+  if (EFI_ERROR (Status) || (Cmos > 60)) {
+    return;
+  }
+
+  Size = sizeof (Previous);
+  Status = gRT->GetVariable (L"CorebootBootTimeout", &mPolicyGuid, NULL, &Size, &Previous);
+  HavePrevious = !EFI_ERROR (Status) && (Size == sizeof (Previous)) && (Previous <= 60);
+  Size = sizeof (Timeout);
+  Status = gRT->GetVariable (L"Timeout", &gEfiGlobalVariableGuid, NULL, &Size, &Timeout);
+  HaveTimeout = !EFI_ERROR (Status) && (Size == sizeof (Timeout));
+
+  // On first use or an OS change, the standard EFI variable stays authoritative.
+  // A changed CMOS preference is an explicit request from CFR or nvramcui.
+  if (HaveTimeout && (!HavePrevious || (Cmos == Previous))) {
+    if (Timeout > 60) {
+      // Do not silently clamp an OS-owned timeout, including the 0xffff sentinel.
+      return;
+    }
+
+    if (Cmos != Timeout) {
+      Cmos = Timeout;
+      Status = CorebootCmosWriteOption (L"boot_timeout", &Cmos, sizeof (Cmos));
+      if (EFI_ERROR (Status)) {
+        DEBUG ((DEBUG_WARN, "CMOS timeout synchronization failed: %r\n", Status));
+        return;
+      }
+    }
+  } else {
+    Timeout = (UINT16)Cmos;
+    Status = gRT->SetVariable (
+                    L"Timeout", &gEfiGlobalVariableGuid,
+                    EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+                    EFI_VARIABLE_RUNTIME_ACCESS, sizeof (Timeout), &Timeout
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_WARN, "EFI timeout update failed: %r\n", Status));
+      return;
+    }
+  }
+
+  Status = PcdSet16S (PcdPlatformBootTimeOut, Timeout);
+  if (!EFI_ERROR (Status) && (!HavePrevious || (Previous != Cmos))) {
+    Status = SavePreference (L"CorebootBootTimeout", (UINT8)Cmos);
+  }
+
+  DEBUG ((DEBUG_INFO, "Coreboot boot timeout=%u: %r\n", Timeout, Status));
+}
+
+VOID
+PlatformApplyLegacyBootPriority (
+  IN UINT16  LegacyOption
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       Previous;
+  UINT32      Policy;
+  UINT16      *Order;
+  UINT16      *NewOrder;
+  UINTN       Size;
+  UINTN       Index;
+  UINTN       Count;
+  UINTN       Out;
+  BOOLEAN     HavePrevious;
+
+  if (EFI_ERROR (CorebootCmosReadOption (L"boot_policy", &Policy)) || (Policy > 2)) {
+    return;
+  }
+
+  Size = sizeof (Previous);
+  Status = gRT->GetVariable (L"CorebootBootPolicy", &mPolicyGuid, NULL, &Size, &Previous);
+  HavePrevious = !EFI_ERROR (Status) && (Size == sizeof (Previous)) && (Previous <= 2);
+  if (HavePrevious && (Previous == Policy)) {
+    return;
+  }
+
+  // Preserve an existing order when first adopting the default UEFI policy.
+  // The inactive legacy entry implements automatic UEFI-only policy.
+  if ((!HavePrevious && (Policy != 2)) || (Policy == 1)) {
+    SavePreference (L"CorebootBootPolicy", (UINT8)Policy);
+    return;
+  }
+
+  Size = 0;
+  Order = NULL;
+  Status = GetVariable2 (L"BootOrder", &gEfiGlobalVariableGuid, (VOID **)&Order, &Size);
+  if (EFI_ERROR (Status) || (Size == 0) || ((Size % sizeof (*Order)) != 0)) {
+    if (Order != NULL) {
+      FreePool (Order);
+    }
+    return;
+  }
+
+  Count = Size / sizeof (*Order);
+  for (Index = 0; Index < Count; Index++) {
+    if (Order[Index] == LegacyOption) {
+      break;
+    }
+  }
+
+  if (Index == Count) {
+    FreePool (Order);
+    return;
+  }
+
+  NewOrder = AllocatePool (Size);
+  if (NewOrder == NULL) {
+    FreePool (Order);
+    return;
+  }
+
+  Out = 0;
+  if (Policy == 2) {
+    NewOrder[Out++] = LegacyOption;
+  }
+
+  for (Index = 0; Index < Count; Index++) {
+    if (Order[Index] != LegacyOption) {
+      NewOrder[Out++] = Order[Index];
+    }
+  }
+
+  if (Policy != 2) {
+    NewOrder[Out++] = LegacyOption;
+  }
+
+  // Refuse malformed duplicate entries instead of changing the variable size.
+  if (Out == Count) {
+    Status = EFI_SUCCESS;
+    if (CompareMem (Order, NewOrder, Size) != 0) {
+      Status = gRT->SetVariable (
+                      L"BootOrder", &gEfiGlobalVariableGuid,
+                      EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+                      EFI_VARIABLE_RUNTIME_ACCESS, Size, NewOrder
+                      );
+    }
+
+    if (!EFI_ERROR (Status)) {
+      SavePreference (L"CorebootBootPolicy", (UINT8)Policy);
+    }
+  }
+
+  FreePool (NewOrder);
+  FreePool (Order);
+}
