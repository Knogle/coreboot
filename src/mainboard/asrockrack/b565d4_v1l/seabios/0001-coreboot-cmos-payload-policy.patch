diff --git a/src/fw/coreboot-cmos.c b/src/fw/coreboot-cmos.c
new file mode 100644
--- /dev/null
+++ b/src/fw/coreboot-cmos.c
@@ -0,0 +1,126 @@
+// Read checked options supplied by coreboot's CMOS layout.
+//
+// This file may be distributed under the terms of the GNU LGPLv3 license.
+
+#include "config.h"
+#include "hw/rtc.h"
+#include "string.h"
+#include "util.h"
+#include "x86.h"
+
+struct cmos_record {
+    u32 tag, size;
+} PACKED;
+
+struct cmos_layout {
+    u32 tag, size, header;
+} PACKED;
+
+struct cmos_option {
+    u32 tag, size, bit, length, config, config_id;
+    char name[0];
+} PACKED;
+
+struct cmos_enum {
+    u32 tag, size, config_id, value;
+} PACKED;
+
+struct cmos_checksum {
+    u32 tag, size, start, end, location, type;
+} PACKED;
+
+// This byte-sized reader deliberately does not write CMOS or touch RTC flags.
+static u32
+coreboot_cmos_read(const struct cmos_layout *layout,
+                   const struct cmos_checksum *sum,
+                   const char *name, u32 fallback, u32 maximum)
+{
+    if (!layout || !sum || !name || layout->tag != 0xc8
+        || layout->header < sizeof(*layout) || layout->size < layout->header
+        || layout->size > 65536 || sum->tag != 0xcc
+        || sum->size != sizeof(*sum) || sum->type != 1
+        || sum->start % 8 || sum->end % 8 != 7 || sum->location % 8
+        || sum->start < 14 * 8 || sum->start > sum->end
+        || sum->end >= 128 * 8 || sum->location < 14 * 8
+        || sum->location > 126 * 8
+        || (sum->location <= sum->end && sum->start <= sum->location + 15))
+        return fallback;
+    const struct cmos_option *found = NULL;
+    u32 offset, length = strlen(name);
+    if (!length || length >= 32)
+        return fallback;
+    for (offset = layout->header; offset < layout->size;) {
+        if (layout->size - offset < sizeof(struct cmos_record))
+            return fallback;
+        const struct cmos_record *record = (const void *)layout + offset;
+        if (record->size < sizeof(*record) || record->size > layout->size - offset)
+            return fallback;
+        if (record->tag == 0xc9) {
+            const struct cmos_option *option = (const void *)record;
+            if (record->size <= sizeof(*option) || record->size > sizeof(*option) + 32)
+                return fallback;
+            u32 bytes = record->size - sizeof(*option), n;
+            for (n = 0; n < bytes && option->name[n]; n++)
+                ;
+            if (n == bytes)
+                return fallback;
+            if (n == length && !memcmp(option->name, name, length)) {
+                if (found)
+                    return fallback;
+                found = option;
+            }
+        } else if (record->tag == 0xca && record->size < sizeof(struct cmos_enum)) {
+            return fallback;
+        }
+        offset += record->size;
+    }
+    if (!found || (found->config != 'e' && found->config != 'h')
+        || found->length != 8 || found->bit % 8 || found->bit < sum->start
+        || found->bit > sum->end || found->length - 1 > sum->end - found->bit)
+        return fallback;
+
+    u32 flags = save_flags();
+    irq_disable();
+    u8 saved = inb(PORT_CMOS_INDEX), value = 0;
+    u16 total = 0;
+    u32 byte;
+    for (byte = sum->start / 8; byte <= sum->end / 8; byte++) {
+        outb((saved & NMI_DISABLE_BIT) | byte, PORT_CMOS_INDEX);
+        u8 current = inb(PORT_CMOS_DATA);
+        total += current;
+        if (byte == found->bit / 8)
+            value = current;
+    }
+    outb((saved & NMI_DISABLE_BIT) | (sum->location / 8), PORT_CMOS_INDEX);
+    u16 stored = (u16)inb(PORT_CMOS_DATA) << 8;
+    outb((saved & NMI_DISABLE_BIT) | (sum->location / 8 + 1), PORT_CMOS_INDEX);
+    stored |= inb(PORT_CMOS_DATA);
+    outb(saved, PORT_CMOS_INDEX);
+    restore_flags(flags);
+    if (total != stored || value > maximum)
+        return fallback;
+    if (found->config == 'h')
+        return value;
+    for (offset = layout->header; offset < layout->size;) {
+        const struct cmos_record *record = (const void *)layout + offset;
+        if (record->tag == 0xca) {
+            const struct cmos_enum *entry = (const void *)record;
+            if (entry->config_id == found->config_id && entry->value == value)
+                return value;
+        }
+        offset += record->size;
+    }
+    return fallback;
+}
+
+u32
+coreboot_cmos_option(const char *name, u32 fallback, u32 maximum)
+{
+    if (!CONFIG_COREBOOT && !CONFIG_CSM)
+        return fallback;
+    struct cb_header *header = find_cb_table();
+    if (!header)
+        return fallback;
+    return coreboot_cmos_read(find_cb_subtable(header, 0xc8),
+                              find_cb_subtable(header, 0xcc), name, fallback, maximum);
+}
