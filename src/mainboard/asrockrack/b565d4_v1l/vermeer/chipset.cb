# Shared DRAM-first build configuration; platform.c supplies desktop operations.
chip soc/amd/cezanne
	device cpu_cluster 0 on ops amd_cpu_bus_ops end
	device domain 0 on ops cezanne_pci_domain_ops
		device pci 00.0 alias gnb on ops cezanne_root_complex_operations end
		device pci 00.2 alias iommu on ops amd_iommu_ops end
		device pci 01.0 on end
		device pci 01.1 alias gpp_bridge_1 on ops amd_external_pcie_gpp_ops end
		device pci 01.2 alias gpp_bridge_0 on ops amd_external_pcie_gpp_ops end
		device pci 01.3 on ops amd_external_pcie_gpp_ops end
		device pci 01.4 on ops amd_external_pcie_gpp_ops end
		device pci 01.5 on ops amd_external_pcie_gpp_ops end
		device pci 01.6 on ops amd_external_pcie_gpp_ops end
		device pci 01.7 on ops amd_external_pcie_gpp_ops end
		device pci 02.0 on end
		device pci 02.1 on ops amd_external_pcie_gpp_ops end
		device pci 03.0 on end
		device pci 03.1 alias gpp_gfx_bridge_0 on ops amd_external_pcie_gpp_ops end
		device pci 03.2 alias gpp_gfx_bridge_1 on ops amd_external_pcie_gpp_ops end
		device pci 03.3 alias gpp_gfx_bridge_2 on ops amd_external_pcie_gpp_ops end
		device pci 03.4 alias gpp_bridge_2 on ops amd_external_pcie_gpp_ops end
		device pci 03.5 on ops amd_external_pcie_gpp_ops end
		device pci 03.6 on ops amd_external_pcie_gpp_ops end
		device pci 03.7 on ops amd_external_pcie_gpp_ops end
		device pci 04.0 on end
		device pci 04.1 on ops amd_external_pcie_gpp_ops end
		device pci 05.0 on end
		device pci 07.0 on end
		device pci 07.1 alias gpp_bridge_c on ops amd_internal_pcie_gpp_ops end
		device pci 08.0 on end
		device pci 08.1 alias gpp_bridge_a on ops amd_internal_pcie_gpp_ops
			device pci 00.0 alias gfx on end
			device pci 00.1 alias crypto on end
			device pci 00.3 alias xhci_0 on ops xhci_pci_ops end
			device pci 00.4 alias hda on end
		end
		device pci 08.2 on ops amd_internal_pcie_gpp_ops end
		device pci 08.3 on ops amd_internal_pcie_gpp_ops end
		device pci 14.0 alias smbus on ops amd_smbus_ops end
		device pci 14.3 alias lpc_bridge on ops amd_lpc_ops end
		device pci 18.0 alias data_fabric_0 on ops amd_data_fabric_ops end
		device pci 18.1 alias data_fabric_1 on ops amd_data_fabric_ops end
		device pci 18.2 alias data_fabric_2 on ops amd_data_fabric_ops end
		device pci 18.3 alias data_fabric_3 on ops amd_data_fabric_ops end
		device pci 18.4 alias data_fabric_4 on ops amd_data_fabric_ops end
		device pci 18.5 alias data_fabric_5 on ops amd_data_fabric_ops end
		device pci 18.6 alias data_fabric_6 on ops amd_data_fabric_ops end
		device pci 18.7 alias data_fabric_7 on ops amd_data_fabric_ops end
	end
end
