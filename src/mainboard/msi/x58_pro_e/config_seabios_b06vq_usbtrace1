# B06VQ-USBTRACE1 keeps the exact boot-capable B06VM policy and adds only a
# bounded, deferred USB initialization journal.  The patched SeaBIOS Kconfig
# requires USB, disabled threading and a nonzero debug level.
CONFIG_COREBOOT=y
# CONFIG_QEMU is not set
# CONFIG_CSM is not set
# CONFIG_QEMU_HARDWARE is not set
# CONFIG_THREADS is not set
CONFIG_RELOCATE_INIT=y
# CONFIG_MALLOC_UPPERMEMORY is not set

CONFIG_BOOT=y
CONFIG_BOOTMENU=y
# CONFIG_BOOTSPLASH is not set
CONFIG_BOOTORDER=y
CONFIG_HOST_BIOS_GEOMETRY=y
CONFIG_COREBOOT_FLASH=y
CONFIG_LZMA=y
# CONFIG_MULTIBOOT is not set
CONFIG_ENTRY_EXTRASTACK=y

CONFIG_DRIVES=y
CONFIG_ATA=y
# CONFIG_ATA_DMA is not set
# CONFIG_ATA_PIO32 is not set
CONFIG_AHCI=y
# CONFIG_SDCARD is not set
# CONFIG_MEGASAS is not set
# CONFIG_FLOPPY is not set
# CONFIG_FLASH_FLOPPY is not set
# CONFIG_NVME is not set
CONFIG_CDROM_BOOT=y
CONFIG_CDROM_EMU=y

CONFIG_USB=y
CONFIG_USB_UHCI=y
# CONFIG_USB_OHCI is not set
CONFIG_USB_EHCI=y
# CONFIG_USB_XHCI is not set
CONFIG_USB_MSC=y
# CONFIG_USB_UAS is not set
CONFIG_USB_HUB=y
CONFIG_USB_KEYBOARD=y
# CONFIG_USB_MOUSE is not set
CONFIG_DEBUG_USB_TRACE=y

CONFIG_KEYBOARD=y
# CONFIG_KBD_CALL_INT15_4F is not set
CONFIG_PS2PORT=y
# CONFIG_MOUSE is not set
CONFIG_SERIAL=y
CONFIG_SERCON=y
# CONFIG_LPT is not set

CONFIG_HARDWARE_IRQ=y
CONFIG_RTC_TIMER=y
CONFIG_PMTIMER=y
CONFIG_TSC_TIMER=y

CONFIG_PCIBIOS=y
# CONFIG_APMBIOS is not set
CONFIG_PNPBIOS=y
CONFIG_OPTIONROMS=y
CONFIG_PMM=y
# CONFIG_S3_RESUME is not set
# CONFIG_VGAHOOKS is not set
# CONFIG_DISABLE_A20 is not set

CONFIG_DEBUG_LEVEL=9
CONFIG_DEBUG_SERIAL=y
CONFIG_DEBUG_SERIAL_PORT=0x3f8
CONFIG_DEBUG_COREBOOT=y
