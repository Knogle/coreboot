# SPDX-License-Identifier: GPL-2.0-only
# ICH10: real chipset device model; only observed direct links are scanned.
chip mainboard/msi/x58_pro_e
	device cpu_cluster 0 on end
	device domain 0 on
		device pci 01.0 mandatory ops x58_full_ioh_ops end
		device pci 03.0 mandatory ops x58_full_ioh_ops
			# Static primary preserves PRIMARY_VGA HD5450-over-XGI selection.
			device pci 00.0 mandatory ops x58_full_endpoint_ops end
		end
		device pci 07.0 mandatory ops x58_full_ioh_ops end
		chip southbridge/intel/i82801jx
			register "sata_port_map" = "0x3f"
			register "sata_clock_request" = "false"
			# Retain the observed reserved GPE0 bit; no event sources enabled.
			register "gpe0_en" = "0x400"
			# Slot/power/hotplug capabilities are retained by the compatibility
			# setup; zero defaults here are not assertions about physical slots.
			device pci 19.0 off end
			device pci 1a.0 mandatory end
			device pci 1a.1 mandatory end
			device pci 1a.2 mandatory end
			device pci 1a.7 mandatory end
			device pci 1b.0 mandatory ops x58_ich10_hda_ops end
			device pci 1c.0 mandatory end
			device pci 1c.1 mandatory end
			device pci 1c.2 mandatory end
			device pci 1c.3 mandatory end
			device pci 1c.4 mandatory end
			device pci 1c.5 mandatory end
			device pci 1d.0 mandatory end
			device pci 1d.1 mandatory end
			device pci 1d.2 mandatory end
			device pci 1d.7 mandatory end
			device pci 1e.0 mandatory end
			device pci 1f.0 mandatory end
			device pci 1f.2 mandatory end
			device pci 1f.3 mandatory end
			device pci 1f.5 off end
			device pci 1f.6 mandatory end
		end
	end
end
