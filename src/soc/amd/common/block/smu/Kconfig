config SOC_AMD_COMMON_BLOCK_SMU
	bool
	select SOC_AMD_COMMON_BLOCK_SMN
	help
	  Select this option to add functions to communicate with the SMU to the build.

config SOC_AMD_COMMON_BLOCK_VERMEER_SMU_POWERPLAY
	bool
	depends on SOC_AMD_COMMON_BLOCK_SMU
	help
	  Import a board-supplied PowerPlay table through the qualified
	  Vermeer SMU interface.

config SOC_AMD_COMMON_BLOCK_VERMEER_SMU_CPPC
	bool
	depends on SOC_AMD_COMMON_BLOCK_SMU
	help
	  Initialize the qualified Vermeer CPPC service and read its
	  capability and frequency description.

config SOC_AMD_COMMON_BLOCK_VERMEER_SMU_PCC
	bool
	depends on SOC_AMD_COMMON_BLOCK_SMU
	select SOC_AMD_COMMON_BLOCK_ACPI_VERMEER_PCC
	help
	  Register and probe the qualified Vermeer CPPC PCC shared-memory
	  interface.

config SOC_AMD_COMMON_BLOCK_VERMEER_SMU_TELEMETRY
	bool
	depends on SOC_AMD_COMMON_BLOCK_SMU
	help
	  Register the qualified Vermeer SMU telemetry owner in CBMEM.

config SOC_AMD_COMMON_BLOCK_SMU_SX_ENTRY
	bool
	depends on SOC_AMD_COMMON_BLOCK_SMU
	help
	  Select this option to add the function to send the S3/4/5 entry
	  message to the SMU.
