# Experimental MSI X58 Pro-E corrected AHCI plus deferred USB trace image.
CONFIG_VENDOR_MSI=y
CONFIG_BOARD_MSI_X58_PRO_E=y
CONFIG_X58_PRO_E_BRINGUP_STAGE=11
CONFIG_X58_PRO_E_B06V0_VENDOR_INIT=y
CONFIG_X58_PRO_E_B06V1_REG_SCRIPT=y
CONFIG_X58_PRO_E_B06V2_CSI_HEADER_FIX=y
CONFIG_X58_PRO_E_B06V3_WARM_RESUME=y
CONFIG_X58_PRO_E_B06V4_POLICY_TELEMETRY=y
CONFIG_X58_PRO_E_B06V5_COLD_MINIT=y
CONFIG_X58_PRO_E_B06V6_AUTO_HANDOFF=y
CONFIG_X58_PRO_E_B06V7_ROBUST_SLOWQPI=y
CONFIG_X58_PRO_E_B06V8_HIGH_QPI_3PASS=y
CONFIG_X58_PRO_E_B06V9_DETERMINISTIC_QPI_3PASS=y
CONFIG_X58_PRO_E_B06VA_HIGH_QPI_A0_SET=y
CONFIG_X58_PRO_E_B06VB_HIGH_QPI_MINIT_OBSERVE=y
CONFIG_X58_PRO_E_B06VC_HIGH_QPI_A0_4SET_MINIT=y
CONFIG_X58_PRO_E_B06VD_HIGH_QPI_CSI2A6_MINIT=y
CONFIG_X58_PRO_E_B06VE_HIGH_QPI_AUTO_HANDOFF=y
CONFIG_X58_PRO_E_B06VF_SEABIOS_ENTRY=y
CONFIG_X58_PRO_E_B06VG_COUPLED_MINIT_SEABIOS=y
CONFIG_X58_PRO_E_B06VH_PRIMARY_WORKSPACE_REARM_SEABIOS=y
CONFIG_X58_PRO_E_B06VI_COUPLED_PROFILE_O_SEABIOS=y
CONFIG_X58_PRO_E_B06VJ_COUPLED_PROFILE_Q_SEABIOS=y
CONFIG_X58_PRO_E_B06VK_Q_CANONICAL_CLASS_SEABIOS=y
CONFIG_X58_PRO_E_B06VL_BROAD_HARD_GATE_SEABIOS=y
CONFIG_X58_PRO_E_B06VM_AUTO_PCI_VGA_IPXE=y
CONFIG_X58_PRO_E_B06VN_IOU0_PCIE_PHYS_VBIOS=y
CONFIG_X58_PRO_E_B06VO_IOHBUSNO_ROUTE=y
CONFIG_X58_PRO_E_B06VP_LAPIC_EXTINT=y
CONFIG_X58_PRO_E_B06VQ_ICH10_EHCI_INIT=y
CONFIG_X58_PRO_E_B06VQ_ICHBASE1=y
CONFIG_X58_PRO_E_B06VU_ICH10_AHCI_ROUTE=y
CONFIG_X58_PRO_E_B06VV_ICH10_PCS_SCLK=y
CONFIG_X58_PRO_E_B06VW_ICH10_AHCI_MMIO=y
CONFIG_X58_PRO_E_B06VX_AHCI_USB_TRACE=y
# CONFIG_X58_PRO_E_B06VQ_PLATRO1 is not set
# CONFIG_X58_PRO_E_B06VQ_USB_TRACE1 is not set
# CONFIG_X58_PRO_E_B06VR_ICH10_AHCI_MAP is not set
# CONFIG_X58_PRO_E_B06VS_ICH10_AHCI_PORTS is not set
# CONFIG_X58_PRO_E_B06VT_ICH10_SATA_CLOCK is not set
CONFIG_CPU_MICROCODE_CBFS_DEFAULT_BINS=y
CONFIG_MICROCODE_UPDATE_PRE_RAM=y
CONFIG_MAINBOARD_PART_NUMBER="X58 Pro-E B06VX AHCI USBTRACE"

# Keep B06VW's exact hardware path. Add only the standalone trace payload,
# 1000-ms attach interval and its read-only pre-SeaBIOS USB telemetry.
CONFIG_PAYLOAD_SEABIOS=y
# CONFIG_SEABIOS_STABLE is not set
CONFIG_SEABIOS_REVISION=y
CONFIG_SEABIOS_REVISION_ID="5497f43189374647b3b0f282aa497e71c891f3c5"
CONFIG_COMPRESSED_PAYLOAD_LZMA=y
CONFIG_PAYLOAD_CONFIGFILE="$(top)/src/mainboard/$(MAINBOARDDIR)/config_seabios_b06vq_usbtrace1"
CONFIG_SEABIOS_DEBUG_LEVEL=9
CONFIG_SEABIOS_HARDWARE_IRQ=y
# CONFIG_SEABIOS_THREAD_OPTIONROMS is not set
CONFIG_SEABIOS_ADD_SERCON_PORT_FILE=y
CONFIG_SEABIOS_SERCON_PORT_ADDR=0x3f8
# CONFIG_VGA_ROM_RUN is not set
CONFIG_NO_GFX_INIT=y

CONFIG_PXE=y
CONFIG_BUILD_IPXE=y
CONFIG_PXE_ROM_ID="10ec,8168"
CONFIG_IPXE_STABLE=y
# CONFIG_IPXE_MASTER is not set
# CONFIG_IPXE_SERIAL_CONSOLE is not set
# CONFIG_IPXE_NO_PROMPT is not set
# CONFIG_IPXE_ADD_SCRIPT is not set
CONFIG_IPXE_HAS_HTTPS=y
CONFIG_IPXE_TRUST_CMD=y

CONFIG_PCI_ALLOW_BUS_MASTER=y
CONFIG_PCI_SET_BUS_MASTER_PCI_BRIDGES=y
# CONFIG_PCI_ALLOW_BUS_MASTER_ANY_DEVICE is not set

CONFIG_GENERATE_SMBIOS_TABLES=y
CONFIG_POST_IO=y
CONFIG_POST_IO_PORT=0x80
# CONFIG_BOOTBLOCK_CONSOLE is not set
CONFIG_CONSOLE_SERIAL=y
CONFIG_CONSOLE_SERIAL_115200=y
CONFIG_UART_FOR_CONSOLE=0
# CONFIG_COLLECT_TIMESTAMPS is not set
CONFIG_NO_SMM=y
CONFIG_LOCALVERSION="x58-pro-e-b06vx"
