 #include "romfile.h" // romfile_loadint
 #include "string.h" // memset
 #include "usb.h" // struct usb_s
@@ -22,6 +23,71 @@
 #include "util.h" // msleep
 #include "x86.h" // __fls
 
+#define USB_TRACE_MAX_EVENTS 96
+
+struct usb_trace_entry {
+    u32 value_a;
+    u32 value_b;
+    u16 bdf;
+    s16 result;
+    u8 event;
+    u8 type;
+    u8 port;
+    u8 reserved;
+};
+
+_Static_assert(sizeof(struct usb_trace_entry) == 16,
+               "USB trace entries must stay within the fixed RAM budget");
+
+static struct usb_trace_entry UsbTrace[USB_TRACE_MAX_EVENTS] VARVERIFY32INIT;
+static u16 UsbTraceCount VARVERIFY32INIT;
+static u16 UsbTraceDropped VARVERIFY32INIT;
+
+void
+usb_trace_record(struct usb_s *cntl, u8 event, u8 port, int result,
+                 u32 value_a, u32 value_b)
+{
+    ASSERT32FLAT();
+    if (! CONFIG_DEBUG_USB_TRACE)
+        return;
+    if (UsbTraceCount >= ARRAY_SIZE(UsbTrace)) {
+        UsbTraceDropped++;
+        return;
+    }
+
+    struct usb_trace_entry *entry = &UsbTrace[UsbTraceCount++];
+    entry->value_a = value_a;
+    entry->value_b = value_b;
+    entry->bdf = cntl && cntl->pci ? cntl->pci->bdf : 0xffff;
+    entry->result = result;
+    entry->event = event;
+    entry->type = cntl ? cntl->type : 0;
+    entry->port = port;
+    entry->reserved = 0;
+}
+
+static void
+usb_trace_dump(void)
+{
+    if (! CONFIG_DEBUG_USB_TRACE)
+        return;
+
+    dprintf(1, "[USBTRACE] BEGIN count=%u dropped=%u\n",
+            (u32)UsbTraceCount, (u32)UsbTraceDropped);
+    int i;
+    for (i = 0; i < UsbTraceCount; i++) {
+        struct usb_trace_entry *entry = &UsbTrace[i];
+        u16 bdf = entry->bdf;
+        dprintf(1,
+                "[USBTRACE] %02u EVT=%02x TYPE=%u BDF=%02x:%02x.%x PORT=%u RET=%d A=%08x B=%08x\n",
+                (u32)i, (u32)entry->event, (u32)entry->type,
+                (u32)(bdf >> 8), (u32)((bdf >> 3) & 0x1f),
+                (u32)(bdf & 7), (u32)entry->port,
+                entry->result, entry->value_a, entry->value_b);
+    }
+    dprintf(1, "[USBTRACE] END\n");
+}
+
 
