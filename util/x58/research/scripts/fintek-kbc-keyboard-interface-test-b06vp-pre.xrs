# Fintek 8042 primary keyboard-interface test behind ICH10R KBC decode.
#
# This follows the separately successful controller self-test.  Command 0xab
# is the standard primary-interface test; reply 0x00 means no clock/data-line
# fault.  It does not prove that a keyboard is attached.  All waits are
# bounded.  The command is non-reversible, so restore LPC_EN afterward with a
# separately gated one-shot exact full-word write 0x2401 -> 0x2001.

assert pci 001f0000 l ffffffff 3a168086
assert pci 001f0080 w ffff 0010
assert pci 001f0082 w ffff 2001
assert io 00000064 b ff ff

mask pci 001f0082 w 0400 0400 rev
assert pci 001f0082 w ffff 2401
# Bit 4 remains set after the immediately preceding controller self-test;
# only OBF/IBF are required idle before the command.
assert io 00000064 b 03 00

write io 00000064 b ab nr
poll io 00000064 b 02 00 000f4240
poll io 00000064 b 01 01 000f4240
assert io 00000060 b ff 00
assert io 00000064 b 03 00

assert pci 001f0082 w ffff 2401
assert pci 001f0000 l ffffffff 3a168086
