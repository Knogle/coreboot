# Re-enter AHCI mode and repeat only the non-DMA SeaBIOS link-start subset
# after HBA reset, then clear PxSERR before a bounded PxTFD-ready poll.  This
# tests whether a fresh SUD/ICC event plus clean DIAG.X lets the initial D2H
# register FIS update PxTFD.  PCI BME and PxCMD.ST/FRE remain clear throughout.

assert pci 001f0200 l ffffffff 3a228086
assert pci 001f0204 w ffff 0002
assert pci 001f0224 l ffffffff cfcff800
assert pci 001f0290 w ffff 0060
assert pci 001f0292 w c0ff 003f
assert pci 001f0294 l ffffffff 00000193
assert pci 001f0500 l ffffffff ffffffff
assert mem cfcff804 l ffffffff 00000000
assert mem cfcff80c l ffffffff 0000003f
assert mem cfcffb98 l ffffffff 00002004
assert mem cfcffba0 l ffffffff 00000080
assert mem cfcffba4 l ffffffff 00000101
assert mem cfcffba8 l ffffffff 00000123
assert mem cfcffbac l ffffffff 00000000
assert mem cfcffbb0 l ffffffff 00000000

mask mem cfcff804 l 80000000 80000000 nr
mask mem cfcffb98 l f0000002 10000002 nr
write mem cfcffbb0 l ffffffff nr

poll mem cfcffba0 l 00000089 00000000 000f4240
read mem cfcffb90 l
read mem cfcffb98 l
read mem cfcffba0 l
read mem cfcffba4 l
read mem cfcffba8 l
read mem cfcffbac l
read mem cfcffbb0 l
assert mem cfcff804 l ffffffff 80000000
assert mem cfcffb98 l 0000c011 00000000
assert pci 001f0204 w ffff 0002
assert pci 001f0500 l ffffffff ffffffff
