# Non-DMA port-5 link-start experiment.  CAP.SSS is set and port 5 reports
# DET=1, so request spin-up plus ICC Active while leaving PxCMD.ST/FRE clear.
# This follows the non-DMA subset of SeaBIOS ahci_port_setup(); it cannot issue
# a storage command because PCI bus mastering and both DMA engines stay off.

assert pci 001f0200 l ffffffff 3a228086
assert pci 001f0204 w ffff 0002
assert pci 001f0224 l ffffffff cfcff800
assert pci 001f0290 w ffff 0060
assert pci 001f0292 w c0ff 003f
assert pci 001f0294 l ffffffff 00000193
assert pci 001f0500 l ffffffff ffffffff
assert mem cfcff800 l ffffffff ff22ffc5
assert mem cfcff804 l ffffffff 80000000
assert mem cfcff80c l ffffffff 0000003f
assert mem cfcffb98 l ffffffff 00002004
assert mem cfcffba8 l 0000000f 00000001
assert mem cfcffbac l 0000000f 00000000

mask mem cfcffb98 l f0000002 10000002 nr

assert mem cfcffb98 l 00000017 00000006
poll mem cfcffba8 l 0000000f 00000003 000f4240
read mem cfcffb98 l
read mem cfcffba0 l
read mem cfcffba4 l
read mem cfcffba8 l
read mem cfcffbac l
read mem cfcffbb0 l
read mem cfcffb90 l

assert pci 001f0204 w ffff 0002
assert mem cfcff804 l ffffffff 80000000
assert mem cfcff80c l ffffffff 0000003f
assert pci 001f0500 l ffffffff ffffffff
