# Invasive CAR-only D29 UHCI companion-port test.  Temporarily decode all
# three reset-state D29 UHCI functions, reproduce MSI GPIO57/H_PWRGD
# output-low/delay/high, then read the six associated PORTSC registers.
# No UHCI operational or port register is written.
#
# Native OC inputs in GP_LVL2 are dynamic/undefined in GPIO reads, so only
# GPIO57 itself is asserted.  A one-second AC cycle is mandatory afterward.

assert pci 001d0000 l ffffffff 3a348086
assert pci 001d0100 l ffffffff 3a358086
assert pci 001d0200 l ffffffff 3a368086
assert pci 001d0004 w ffff 0000
assert pci 001d0104 w ffff 0000
assert pci 001d0204 w ffff 0000
assert pci 001d0020 l ffffffff 00000001
assert pci 001d0120 l ffffffff 00000001
assert pci 001d0220 l ffffffff 00000001
assert io 000005b0 l ffffffff 030300ff
assert io 000005b7 b ff 0f
assert io 000005bb b ff 15
write pci 001d0020 l 0000df81 rev
write pci 001d0004 w 00000001 rev
write pci 001d0120 l 0000df61 rev
write pci 001d0104 w 00000001 rev
write pci 001d0220 l 0000df41 rev
write pci 001d0204 w 00000001 rev
mask io 000005b7 b 02 00 rev
assert io 000005b7 b 02 00
delay 00010000
mask io 000005bb b 00 02 rev
assert io 000005bb b 02 02
delay 00010000
read io 0000df90 w
read io 0000df92 w
read io 0000df70 w
read io 0000df72 w
read io 0000df50 w
read io 0000df52 w
