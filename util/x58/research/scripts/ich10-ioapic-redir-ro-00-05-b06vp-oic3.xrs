# Read IOAPIC redirection entries 0..5 after the proved OIC=03 decode.
# Only IOREGSEL is written and every selector write is reversible.  IOWIN,
# redirection data, PIC, LAPIC, PIRQ, SCI and SMI state remain untouched.
# Run in CAR/ROMMON with CPU interrupts disabled; archive the trace.

assert pci 001f0000 l ffffffff 3a168086
assert pci 001f00f0 l ffffffff fed1c001
assert mem fed1f1ff b ff 03
assert mem fec00000 l ffffffff 00000000

write mem fec00000 l 00000010 rev
read mem fec00010 l
write mem fec00000 l 00000011 rev
read mem fec00010 l
write mem fec00000 l 00000012 rev
read mem fec00010 l
write mem fec00000 l 00000013 rev
read mem fec00010 l
write mem fec00000 l 00000014 rev
read mem fec00010 l
write mem fec00000 l 00000015 rev
read mem fec00010 l
write mem fec00000 l 00000016 rev
read mem fec00010 l
write mem fec00000 l 00000017 rev
read mem fec00010 l
write mem fec00000 l 00000018 rev
read mem fec00010 l
write mem fec00000 l 00000019 rev
read mem fec00010 l
write mem fec00000 l 0000001a rev
read mem fec00010 l
write mem fec00000 l 0000001b rev
read mem fec00010 l

write mem fec00000 l 00000000 rev
assert mem fec00000 l ffffffff 00000000
assert mem fed1f1ff b ff 03
assert pci 001f00f0 l ffffffff fed1c001
