# Read IOAPIC redirection entries 6..11 after the proved OIC=03 decode.
# Only IOREGSEL is written and every selector write is reversible.  IOWIN,
# redirection data, PIC, LAPIC, PIRQ, SCI and SMI state remain untouched.
# Run in CAR/ROMMON with CPU interrupts disabled; archive the trace.

assert pci 001f0000 l ffffffff 3a168086
assert pci 001f00f0 l ffffffff fed1c001
assert mem fed1f1ff b ff 03
assert mem fec00000 l ffffffff 00000000

write mem fec00000 l 0000001c rev
read mem fec00010 l
write mem fec00000 l 0000001d rev
read mem fec00010 l
write mem fec00000 l 0000001e rev
read mem fec00010 l
write mem fec00000 l 0000001f rev
read mem fec00010 l
write mem fec00000 l 00000020 rev
read mem fec00010 l
write mem fec00000 l 00000021 rev
read mem fec00010 l
write mem fec00000 l 00000022 rev
read mem fec00010 l
write mem fec00000 l 00000023 rev
read mem fec00010 l
write mem fec00000 l 00000024 rev
read mem fec00010 l
write mem fec00000 l 00000025 rev
read mem fec00010 l
write mem fec00000 l 00000026 rev
read mem fec00010 l
write mem fec00000 l 00000027 rev
read mem fec00010 l

write mem fec00000 l 00000000 rev
assert mem fec00000 l ffffffff 00000000
assert mem fed1f1ff b ff 03
assert pci 001f00f0 l ffffffff fed1c001
