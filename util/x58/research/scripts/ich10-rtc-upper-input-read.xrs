# ICH10 RTC upper-bank read of the MSI wrapper policy inputs.
#
# Intel ICH10 Datasheet 319973-003, sections 10.1.73 and 13.6:
# RCBA + 0x3400 bit 2 enables the upper 128-byte RTC RAM bank at ports
# 0x72/0x73.  With that bit clear, those ports alias standard RTC RAM.
#
# All mutations are marked reversible.  Run with `keep`, record every read,
# then explicitly roll back the reported TXN_FNV so both RC and the saved
# index selector return to their pre-run values.

read mem fed1f400 l
mask mem fed1f400 l 00000000 00000004 rev
assert mem fed1f400 l 00000004 00000004

# With U128E set, port 0x72 consumes a seven-bit selector.  Logical upper
# addresses 80/81/82/88/89/8e/ca/f1/f5 therefore use 00/01/02/08/09/0e/4a/71/75.
write io 00000072 b 00 rev
read io 00000073 b
write io 00000072 b 01 rev
read io 00000073 b
write io 00000072 b 02 rev
read io 00000073 b
write io 00000072 b 08 rev
read io 00000073 b
write io 00000072 b 09 rev
read io 00000073 b
write io 00000072 b 0e rev
read io 00000073 b
write io 00000072 b 4a rev
read io 00000073 b
write io 00000072 b 71 rev
read io 00000073 b
write io 00000072 b 75 rev
read io 00000073 b
