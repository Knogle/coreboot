# Temporarily decode the three D29 UHCI companions in their previously proven
# coreboot I/O windows.  Controllers remain halted; only BAR4 and PCI_COMMAND
# change, both reversibly.  No USB command or port register is written.

assert pci 001d0000 l ffffffff 3a348086
assert pci 001d0100 l ffffffff 3a358086
assert pci 001d0200 l ffffffff 3a368086
assert pci 001d0004 w ffff 0000
assert pci 001d0104 w ffff 0000
assert pci 001d0204 w ffff 0000
assert pci 001d0020 l ffffffff 00000001
assert pci 001d0120 l ffffffff 00000001
assert pci 001d0220 l ffffffff 00000001
write pci 001d0020 l 0000df81 rev
write pci 001d0004 w 00000001 rev
write pci 001d0120 l 0000df61 rev
write pci 001d0104 w 00000001 rev
write pci 001d0220 l 0000df41 rev
write pci 001d0204 w 00000001 rev
read io 0000df80 w
read io 0000df82 w
read io 0000df90 w
read io 0000df92 w
read io 0000df60 w
read io 0000df62 w
read io 0000df70 w
read io 0000df72 w
read io 0000df40 w
read io 0000df42 w
read io 0000df50 w
read io 0000df52 w
assert pci 001d0000 l ffffffff 3a348086
assert pci 001d0100 l ffffffff 3a358086
assert pci 001d0200 l ffffffff 3a368086
